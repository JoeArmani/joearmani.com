---
// Shared page masthead: diamond kicker + title + optional subtitle.
// Used by Blog, Projects, Uses, Now, Subscribe, and About so the header
// treatment stays consistent in one place. Styling lives in global.css
// (.page-header / __kicker / __subtitle / --center).
interface Props {
  kicker?: string;
  title: string;
  subtitle?: string;
  center?: boolean;
}

const { kicker, title, subtitle, center = false } = Astro.props;
---

<div class:list={['page-header', { 'page-header--center': center }]}>
  {kicker && <p class="page-header__kicker">{kicker}</p>}
  <h1>{title}</h1>
  {subtitle && <p class="page-header__subtitle">{subtitle}</p>}
</div>
