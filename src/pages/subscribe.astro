---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubscribeForm from '../components/Subscribe.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---

<BaseLayout
  title="Subscribe | Joe Armani"
  description="Writing on AI development & agentic tools, buiding & shipping software, and discussing the successes and failures along the way."
>
  <div class="container--narrow" style="padding-top: 6rem; padding-bottom: 6rem;">
    <Breadcrumbs items={[
      { label: "Home", href: "/" },
      { label: "Subscribe" },
    ]} />
    <div class="page-header page-header--center">
      <p class="page-header__kicker">The newsletter</p>
      <h1>Subscribe</h1>
      <p class="page-header__subtitle">Writing on AI development & agentic tools, building & shipping software, and discussing the successes and failures along the way.</p>
    </div>
    <SubscribeForm variant="full" />
  </div>
</BaseLayout>
