---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubscribeForm from '../components/Subscribe.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout
  title="Subscribe | Joe Armani"
  description="Writing on AI development & agentic tools, buiding & shipping software, and discussing the successes and failures along the way."
>
  <div class="container--narrow" style="padding-top: 6rem; padding-bottom: 6rem;">
    <Breadcrumbs items={[
      { label: "Home", href: "/" },
      { label: "Subscribe" },
    ]} />
    <PageHeader
      kicker="The newsletter"
      title="Subscribe"
      subtitle="Writing on AI development & agentic tools, building & shipping software, and discussing the successes and failures along the way."
      center
    />
    <SubscribeForm variant="full" />
  </div>
</BaseLayout>
