---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageHeader from '../components/PageHeader.astro';
import { nowSections, nowUpdated } from '../data/now';
---

<BaseLayout
  title="Now | Joe Armani"
  description="What I'm currently working on, reading, and building."
>
  <div class="container--narrow" style="padding-bottom: 4rem;">
    <Breadcrumbs items={[
      { label: "Home", href: "/" },
      { label: "Now" },
    ]} />
    <PageHeader
      kicker="Currently"
      title="Now"
      subtitle="What I'm focused on right now."
    />
    <div class="about-content">
      {nowSections.map((section) => (
        <Fragment>
          <h2>{section.kind}</h2>
          <ul>
            {section.items.map((item) => (
              <li><strong>{item.lead}</strong>: {item.body}</li>
            ))}
          </ul>
        </Fragment>
      ))}

      <p style="margin-top: 2.5rem; font-size: 0.9rem; color: var(--text-muted);">
        Updated roughly monthly. Last update: {nowUpdated}.
      </p>
    </div>
  </div>
</BaseLayout>
