---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Subscribe from '../components/Subscribe.astro';
import { getCollection } from 'astro:content';
import { compareEditorialDatesDesc } from '../utils/dates';
import { formatEditorialDate } from '../utils/dates';
import { nowSections, nowUpdated } from '../data/now';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);

const latestPosts = allPosts
  .sort((a, b) => compareEditorialDatesDesc(a.data.date, b.data.date))
  .slice(0, 3);

const featuredProjects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<BaseLayout
  title="Joe Armani | Engineer building with AI"
  description="Software Engineer. Building with AI, writing the manual as I go."
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Joe Armani",
    "url": "https://joearmani.com",
    "description": "I build AI-powered systems and write about what actually works.",
    "author": {
      "@type": "Person",
      "name": "Joe Armani",
      "url": "https://joearmani.com/about"
    }
  })} />

  <Hero />

  {latestPosts.length > 0 && (
    <section class="container--narrow home-section" id="writing">
      <div class="home-sectionhead reveal">
        <span class="home-sectionhead__label">Writing</span>
        <span class="home-sectionhead__rule"></span>
        <a href="/blog/" class="home-sectionhead__link">All posts →</a>
      </div>
      <ol class="home-feed">
        {latestPosts.map((post) => (
          <li class="home-feed__entry reveal">
            <a class="home-feed__link" href={`/blog/${post.id}`}>
              <div class="home-feed__side">
                <span class="home-feed__date">{formatEditorialDate(post.data.date)}</span>
              </div>
              <div class="home-feed__body">
                <h3 class="home-feed__title">{post.data.title}</h3>
                <p class="home-feed__blurb">{post.data.description}</p>
                <div class="home-feed__meta">
                  {post.data.readingTime && <span>{post.data.readingTime} min read</span>}
                  {post.data.readingTime && <span class="home-feed__dot">·</span>}
                  <span>{post.data.tags.join(' · ')}</span>
                </div>
              </div>
              <span class="home-feed__go" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section class="container--narrow home-section" id="building">
    <div class="home-sectionhead reveal">
      <span class="home-sectionhead__label">Building</span>
      <span class="home-sectionhead__rule"></span>
      <a href="/projects/" class="home-sectionhead__link">All projects →</a>
    </div>
    <div class="home-projgrid">
      {featuredProjects.map((project) => (
        <a class="home-proj reveal" href={`/projects/${project.id}`}>
          <div class="home-proj__head">
            <h3 class="home-proj__title">{project.data.title}</h3>
            <span class={`home-proj__status status-badge status-badge--${project.data.status.toLowerCase()}`}>{project.data.status}</span>
          </div>
          <p class="home-proj__blurb">{project.data.description}</p>
          <div class="home-proj__stack">{project.data.tags.join('  ·  ')}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="container--narrow home-section" id="now">
    <div class="home-sectionhead reveal">
      <span class="home-sectionhead__label">Now</span>
      <span class="home-sectionhead__rule"></span>
      <a href="/now/" class="home-sectionhead__link">Updated {nowUpdated} →</a>
    </div>
    <ul class="home-now">
      {nowSections.map((section) => (
        <li class="reveal">
          <span class="home-now__kind">{section.kind}</span>
          <span class="home-now__text">{section.summary}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="container">
    <div class="reveal">
      <Subscribe variant="full" />
    </div>
  </section>
</BaseLayout>
