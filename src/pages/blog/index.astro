---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getCollection } from 'astro:content';
import { compareEditorialDatesDesc, formatEditorialDate } from '../../utils/dates';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => compareEditorialDatesDesc(a.data.date, b.data.date));

// Count tag frequency and surface recurring topics cleanly (fallback to all tags if < 2 recur).
const tagCounts = new Map<string, number>();
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const recurringTags = [...tagCounts.entries()]
  .filter(([, count]) => count >= 2)
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

const filterTags = recurringTags.length >= 2
  ? recurringTags
  : [...tagCounts.entries()].sort((a, b) => a[0].localeCompare(b[0]));

// Group posts by publication year (descending)
const yearMap = new Map<string, typeof posts>();
for (const post of posts) {
  const year = String(post.data.date).slice(0, 4);
  const bucket = yearMap.get(year) ?? [];
  bucket.push(post);
  yearMap.set(year, bucket);
}
const postsByYear = [...yearMap.entries()];
---

<BaseLayout
  title="Writing | Joe Armani"
  description="Writing on AI development, agentic tools, and building software products."
>
  <div class="container blog-index">
    <Breadcrumbs items={[
      { label: "Home", href: "/" },
      { label: "Blog" },
    ]} />
    <PageHeader
      kicker="The blog"
      title="Writing"
      subtitle="Writing on AI development, agentic tools, and building software products."
    />

    {posts.length > 0 ? (
      <>
        <div class="tag-filter" role="group" aria-label="Filter posts by topic">
          <button type="button" class="tag-filter__btn active" data-tag="all" aria-pressed="true">
            All<span class="tag-filter__count">({posts.length})</span>
          </button>
          {filterTags.map(([tag, count]) => (
            <button type="button" class="tag-filter__btn" data-tag={tag} aria-pressed="false">
              {tag}<span class="tag-filter__count">({count})</span>
            </button>
          ))}
        </div>

        <div id="writing-list">
          {postsByYear.map(([year, yearPosts]) => (
            <section class="blog-year-group" data-year-group={year}>
              <h2 class="blog-year-group__heading">{year}</h2>
              <ol class="home-feed">
                {yearPosts.map((post) => (
                  <li
                    class="home-feed__entry"
                    data-tags={post.data.tags.join(',')}
                  >
                    <a class="home-feed__link" href={`/blog/${post.id}/`}>
                      <div class="home-feed__side">
                        <time class="home-feed__date" datetime={String(post.data.date)}>
                          {formatEditorialDate(post.data.date)}
                        </time>
                        {post.data.featured && <span class="home-feed__badge">Featured</span>}
                      </div>
                      <div class="home-feed__body">
                        <h3 class="home-feed__title">{post.data.title}</h3>
                        <p class="home-feed__blurb">{post.data.description}</p>
                        <div class="home-feed__meta">
                          {post.data.readingTime && <span>{post.data.readingTime} min read</span>}
                          {post.data.readingTime && <span class="home-feed__dot">·</span>}
                          <span>{post.data.tags.join(' · ')}</span>
                        </div>
                      </div>
                      <span class="home-feed__go" aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </div>
      </>
    ) : (
      <p style="color: var(--text-secondary); font-size: 1.05rem; padding: 2rem 0;">First post coming soon. Subscribe to get notified when it drops.</p>
    )}
  </div>
</BaseLayout>

{posts.length > 0 && (
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('.tag-filter__btn');
    const entries = document.querySelectorAll<HTMLElement>('#writing-list .home-feed__entry');
    const yearGroups = document.querySelectorAll<HTMLElement>('.blog-year-group');

    function filterByTag(activeTag: string) {
      entries.forEach((entry) => {
        if (activeTag === 'all') {
          entry.style.display = '';
          return;
        }
        const entryTags = entry.getAttribute('data-tags')?.split(',') || [];
        entry.style.display = entryTags.includes(activeTag) ? '' : 'none';
      });

      yearGroups.forEach((group) => {
        const visibleCount = [...group.querySelectorAll<HTMLElement>('.home-feed__entry')]
          .filter((el) => el.style.display !== 'none').length;
        group.style.display = visibleCount > 0 ? '' : 'none';
      });
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((button) => {
          button.classList.remove('active');
          button.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        filterByTag(btn.getAttribute('data-tag') || 'all');
      });
    });
  </script>
)}
