---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Joe Armani"
  description="The page you're looking for doesn't exist."
>
  <div class="notfound container--narrow">
    <p class="notfound__kicker">Error · 404</p>
    <h1 class="notfound__code">404</h1>
    <p class="notfound__lead">Nothing here.</p>
    <p class="notfound__sub">Might've moved. Might never have existed. Either way, here's where to go from here:</p>
    <div class="notfound__ctas">
      <a href="/" class="btn btn--primary">Back to Home</a>
      <a href="/blog/" class="btn btn--outline">Read the Blog</a>
    </div>
  </div>
</BaseLayout>
